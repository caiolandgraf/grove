package models

import (
	"time"

	"{{.Module}}/internal/app"
	"{{.Module}}/internal/app/database"
	"gorm.io/gorm"
)

type {{.Name}} struct {
	ID        string         `gorm:"type:uuid;primaryKey;default:gen_random_uuid()" json:"id"`
	CreatedAt time.Time      `gorm:"autoCreateTime"                                 json:"created_at"`
	UpdatedAt time.Time      `gorm:"autoUpdateTime"                                 json:"updated_at"`
	DeletedAt gorm.DeletedAt `gorm:"index"                                          json:"-"`
	// Outros campos
}

func ({{.Name}}) TableName() string { return "{{.TableName}}" }

type {{.NameLower}}Repository struct {
	*database.Repository[{{.Name}}]
}

func {{.PluralName}}() *{{.NameLower}}Repository {
	return &{{.NameLower}}Repository{
		Repository: database.New[{{.Name}}](app.DB),
	}
}
