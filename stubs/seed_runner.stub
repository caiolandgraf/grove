package main

import (
	"fmt"
	"os"

	"{{.Module}}/internal/app"
	"{{.Module}}/internal/database/seeders"
)

func main() {
	// Initialize shared singletons (DB, Session, Metrics, etc.)
	// This should load .env via your app bootstrap if configured in go-project-base.
	app.Init()

	if app.DB == nil {
		fmt.Fprintln(os.Stderr, "database not initialized (app.DB is nil)")
		os.Exit(1)
	}

	if err := seeders.Run(app.DB); err != nil {
		fmt.Fprintln(os.Stderr, err.Error())
		os.Exit(1)
	}

	fmt.Println("seeders completed")
}
